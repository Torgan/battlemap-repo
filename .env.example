# ---- Reddit ----
# Always set a descriptive, non-generic User-Agent (a username/contact is polite).
REDDIT_USER_AGENT=battlemap-repo/0.1 by u/your_username
# Optional: a "script" app's client id/secret enables authenticated OAuth — full galleries
# and more robust than RSS. Leave blank to use the public RSS fallback (single image/gallery).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOURPROJECT.supabase.co
# Service-role key is SECRET. Used only by the scraper (server-side). Never ship to the web client.
SUPABASE_SERVICE_KEY=
# Anon key is public-safe. Used by the Next.js web app and the Foundry module.
SUPABASE_ANON_KEY=

# ---- Cloudflare R2 (S3-compatible) ----
# Create a bucket + API token (Account ID is in the R2 dashboard URL).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=battlemaps
# Public bucket base URL (enable r2.dev public access or a custom domain), e.g.
# https://pub-xxxxxxxx.r2.dev   or   https://maps.example.com
R2_PUBLIC_BASE_URL=

# ---- Optional: AI vision tagging. Leave AI_PROVIDER blank to disable. ----
# "openai"   = any OpenAI-compatible API. FREE + EU-friendly (recommended):
#              Mistral (primary): OPENAI_BASE_URL=https://api.mistral.ai/v1   key: https://console.mistral.ai
#                                 OPENAI_MODEL=ministral-14b-2512
#                Free mode is on by default, but limits are per model: mistral-small/medium get
#                0 req/min, ministral-14b gets ~190 req/min (Admin panel > API > Limits).
#              Groq:              OPENAI_BASE_URL=https://api.groq.com/openai/v1   key: https://console.groq.com/keys
#                                 OPENAI_MODEL=qwen/qwen3.8-27b   (free: 200k tokens/day ~ 85 maps)
#              OpenRouter:        OPENAI_BASE_URL=https://openrouter.ai/api/v1     key: https://openrouter.ai/keys
# "gemini"   = Google Gemini (free tier NOT available in the EU/UK — gives limit:0).
# "anthropic"= Claude (paid, ~$0.003/map).
AI_PROVIDER=
OPENAI_BASE_URL=https://api.mistral.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=ministral-14b-2512
# Optional fallback, used whenever the provider above fails (quota exhausted, errors).
# Blank key = no fallback.
OPENAI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
OPENAI_FALLBACK_API_KEY=
OPENAI_FALLBACK_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Scraper tuning ----
DEFAULT_FETCH_LIMIT=50
PHASH_MAX_DISTANCE=4
# Seconds before a run stops starting new sources (Reddit RSS allows ~1 feed/min).
RUN_TIME_BUDGET_S=1500
